# ~/.zshrc — gestionado por ~/Projects/entorno-mac
# Editar en el repo y re-lanzar shell (o: source ~/.zshrc)

# ---------------------------------------------------------------------------
# Homebrew (por si la sesión no cargó .zprofile)
# ---------------------------------------------------------------------------
if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv zsh)"
fi

# Cursor Agent / bins locales
export PATH="${HOME}/.local/bin:${PATH}"

# ---------------------------------------------------------------------------
# Autocomplete (antes de cualquier compinit / compdef)
# https://github.com/marlonrichert/zsh-autocomplete
# ---------------------------------------------------------------------------
if [[ -r "$(brew --prefix)/share/zsh-autocomplete/zsh-autocomplete.plugin.zsh" ]]; then
  source "$(brew --prefix)/share/zsh-autocomplete/zsh-autocomplete.plugin.zsh"
fi

# ---------------------------------------------------------------------------
# Historia
# ---------------------------------------------------------------------------
HISTFILE="${HOME}/.zsh_history"
HISTSIZE=50000
SAVEHIST=50000
setopt SHARE_HISTORY HIST_IGNORE_DUPS HIST_IGNORE_SPACE EXTENDED_HISTORY

# cdr / chpwd-recent-dirs (zsh-autocomplete lo usa)
mkdir -p "${HOME}/.local/share/zsh"
: >> "${HOME}/.local/share/zsh/chpwd-recent-dirs"

# ---------------------------------------------------------------------------
# fnm (Node)
# ---------------------------------------------------------------------------
if command -v fnm >/dev/null 2>&1; then
  eval "$(fnm env --use-on-cd --shell zsh)"
fi

# ---------------------------------------------------------------------------
# Herramientas
# ---------------------------------------------------------------------------
if command -v starship >/dev/null 2>&1; then
  eval "$(starship init zsh)"
fi

if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init zsh)"
fi

if command -v fzf >/dev/null 2>&1; then
  # Solo keybindings: el completion de fzf choca con zsh-autocomplete
  # shellcheck disable=SC1090
  [[ -f "$(brew --prefix)/opt/fzf/shell/key-bindings.zsh" ]] && source "$(brew --prefix)/opt/fzf/shell/key-bindings.zsh"
fi

# ---------------------------------------------------------------------------
# Aliases (set mínimo — ver aliases.zsh)
# ---------------------------------------------------------------------------
if [[ -L "${HOME}/.zshrc" ]]; then
  _entorno_dotfiles="$(cd "$(dirname "$(readlink "${HOME}/.zshrc")")" && pwd)"
  [[ -r "${_entorno_dotfiles}/aliases.zsh" ]] && source "${_entorno_dotfiles}/aliases.zsh"
  unset _entorno_dotfiles
fi

# ---------------------------------------------------------------------------
# Entorno
# ---------------------------------------------------------------------------
export EDITOR="${EDITOR:-nvim}"
export VISUAL="${VISUAL:-$EDITOR}"
export LANG="${LANG:-es_ES.UTF-8}"
# ---------------------------------------------------------------------------
# Autosuggestions (al final)
# https://github.com/zsh-users/zsh-autosuggestions
# ---------------------------------------------------------------------------
if [[ -r "$(brew --prefix)/share/zsh-autosuggestions/zsh-autosuggestions.zsh" ]]; then
  source "$(brew --prefix)/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
  # Aceptar sugerencia con → o fin de línea
  bindkey '^[[C' forward-char
  bindkey '^E' autosuggest-accept
fi
